# Copy to .env.local and fill in. All optional — the site works with none of
# these set, using static fallbacks (see constants/index.ts).

# Absolute origin used for canonical URLs, OG tags, and the sitemap.
# Defaults to https://sohammaury.me in code if unset.
NEXT_PUBLIC_SITE_URL=

# Upstash Redis (Storage -> Marketplace -> Upstash in the Vercel dashboard),
# powers the real visitor counter at app/api/visits/route.ts. Without these,
# the footer just shows the static Site.visitorCount fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
